# ===================================================================
# A comprehensive .gitignore for Java, Gradle/Maven, and VS Code
# ===================================================================

# General build output and temporary files
/build/
/target/
out/
bin/

# Compiled Java class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# IDE-specific files
# ---------------------------------

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# IntelliJ IDEA
.idea/
*.iml
*.iws

# Eclipse
.classpath
.project
.settings/

# NetBeans
/nbproject/private/
/build/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/


# Build Tool specific files
# ---------------------------------

# Gradle
.gradle/
build/
# Ignore Gradle build caches and user-specific files
# IMPORTANT: Do NOT ignore the Gradle Wrapper files (gradlew, gradlew.bat, gradle/wrapper)
# They should be committed to your repository.

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.bak
*.releaseProfiles

# Operating System generated files
# ---------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Sensitive Information - NEVER commit these!
# ---------------------------------
*.env
application-local.properties
application-local.yml
secrets/